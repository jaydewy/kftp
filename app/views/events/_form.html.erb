<%= form_with model: @event do |f| %>
    <% if @event.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@event.errors.count, "error") %> prohibited this event from being saved:</h2>

      <ul>
        <% @event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <%= f.label :name, "Event Name" %>
    <%= f.text_field :name %>

    <%= f.label :start_date, "Start Date" %>
    <%= f.date_field :start_date %>

    <%= f.label :end_date, "End Date" %>
    <%= f.date_field :end_date %>

    <%= f.check_box :active %>
    <%= f.label :active, "Set as active event" %><br />

    <p></p>
    <p>Previous event can only be set at creation time, not updated later. If reservations are to be copied, this must also be done at creation time.</p>

    <%= f.label :previous_event_id, "Previous Event" %>
    <%= f.collection_select :previous_event_id, Event.where.not(id: @event.id), :id, :name, { include_blank: true }, { disabled: @event.persisted? } %> 

    <%= check_box_tag :copy_reservations_from_previous_event, 'yes', false, disabled: @event.persisted? %>
    <%= label_tag "Copy reservations from previous event?" %><br /> 
    <p></p>

    <%= f.submit %>

<% end %>